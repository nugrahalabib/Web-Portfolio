const TiktokIcon: React.FC = () => (
  <svg className="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.02 1.59 4.23.85.97 2.02 1.67 3.29 2.05v3.91c-.99-.08-1.96-.39-2.85-.88-.93-.53-1.74-1.3-2.34-2.22-.04 2.82-.01 5.64-.03 8.46-.03 1.43-.37 2.87-1.04 4.14-.62 1.15-1.57 2.14-2.73 2.79-1.29.72-2.79 1.05-4.27.97-1.81-.07-3.62-.73-5.02-1.9-1.42-1.18-2.37-2.91-2.61-4.73-.29-2.14.23-4.37 1.48-6.13 1.15-1.63 2.94-2.78 4.93-3.15.86-.17 1.75-.22 2.62-.16v3.92c-.89-.14-1.83.02-2.61.53-.78.49-1.34 1.32-1.52 2.22-.19 1.02.09 2.12.75 2.92.59.73 1.47 1.19 2.4 1.25.99.07 2-.28 2.68-.99.64-.69.93-1.64.91-2.58-.02-3.41-.01-6.82-.01-10.23-.02-.13-.01-.27-.02-.4z"/>
