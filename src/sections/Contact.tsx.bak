// Simulated live port connection signal bars
const SignalBars: React.FC<{ active: boolean }> = ({ active }) => {
  return (
    <div className="flex items-end gap-[1.5px] h-3 ml-auto opacity-75 shrink-0">
      {[...Array(5)].map((_, i) => (
        <motion.div
          key={i}
          className="w-[1.5px] bg-current"
          initial={{ height: 2 + i * 2 }}
          animate={active ? {
            height: [
              2 + i * 2,
              Math.min(12, Math.max(2, (2 + i * 2) + Math.floor(Math.random() * 6 - 3))),
              2 + i * 2
            ]
          } : { height: 2 + i * 2 }}
          transition={active ? {
            duration: 0.4 + Math.random() * 0.4,
            repeat: Infinity,
            ease: "easeInOut"
          } : { duration: 0.2 }}
        />
      ))}
    </div>
  );
};

export const Contact: React.FC = () => {
  const { personal } = portfolioData;
  const { language } = useLanguage();
  
  // Console state tabs
  const [activeMode, setActiveMode] = useState<'direct' | 'compose'>('direct');
  
  // Composer state
  const [senderName, setSenderName] = useState('');
  const [intent, setIntent] = useState<'collab' | 'consult' | 'sponsor' | 'ping'>('collab');
  const [payload, setPayload] = useState('');
  
  const [copiedEmail, setCopiedEmail] = useState(false);
  const [copiedPayload, setCopiedPayload] = useState(false);
  const [hoveredPort, setHoveredPort] = useState<string | null>(null);

  const contactTitle = language === 'en' ? 'CONTACT' : 'KONTAK';
  const subtitle = language === 'en' 
    ? 'Establish Connection // Database Transmission' 
    : 'Hubungkan Komunikasi // Transmisi Data';

  // Intent Email Templates (Simplified Category Names)
  const intentTemplates = {
    collab: {
      label: { en: 'COLLABORATION', id: 'KOLABORASI' },
      subject: {
        en: '[COLLAB] AI Venture & Startup Collaboration',
        id: '[KOLABORASI] Kerja Sama Startup & Ventura AI'
      },
      defaultBody: {
        en: "Hi Nugi,\n\nI am interested in collaborating on AI startup ventures or technical product development. Let's discuss how we can build something awesome together.",
        id: "Halo Nugi,\n\nSaya tertarik untuk berkolaborasi dalam ventura startup AI atau pengembangan produk teknis. Mari kita diskusikan bagaimana kita bisa membangun sesuatu yang hebat bersama."
      }
    },
    consult: {
      label: { en: 'AI CONSULT', id: 'KONSULTASI AI' },
      subject: {
        en: '[CONSULT] Agentic Workflows & System Automation',
        id: '[KONSULTASI] Alur Kerja Agen & Otomatisasi Sistem'
      },
      defaultBody: {
        en: "Hi Nugi,\n\nWe are looking to implement autonomous AI workflows and n8n/LangGraph integrations. I'd like to consult with you on engineering self-correcting RAG systems for our operations.",
        id: "Halo Nugi,\n\nKami berencana untuk menerapkan alur kerja AI otonom dan integrasi n8n/LangGraph. Saya ingin berkonsultasi mengenai perancangan sistem RAG yang mandiri untuk operasional kami."
      }
    },
    sponsor: {
      label: { en: 'SPONSORSHIP', id: 'SPONSORSHIP' },
      subject: {
        en: '[SPONSOR] Tech Content & Branding Partnership',
        id: '[SPONSOR] Kemitraan Konten & Branding Teknologi'
      },
      defaultBody: {
        en: "Hi Nugi,\n\nWe saw your tech creator content with 140K+ audience and would love to partner with you for a brand sponsorship or product review campaign.",
        id: "Halo Nugi,\n\nKami melihat konten kreator teknologi Anda dengan 140 ribu+ pengikut dan ingin bermitra untuk kampanye sponsor merek atau ulasan produk."
      }
    },
    ping: {
      label: { en: 'SAY HELLO', id: 'MENYAPA' },
      subject: {
        en: '[PING] Networking & Tech Talk',
        id: '[PING] Jejaring & Obrolan Teknologi'
      },
      defaultBody: {
        en: "Hi Nugi,\n\nJust wanted to reach out, connect, and say hello! I'm interested in following your journey in the AI agentic ecosystem.",
        id: "Halo Nugi,\n\nHanya ingin menyapa, berkenalan, dan terhubung! Saya tertarik untuk mengikuti perkembangan perjalanan Anda di ekosistem agen AI."
      }
    }
  };

  // Sync draft templates when language changes
  useEffect(() => {
    const otherLang = language === 'en' ? 'id' : 'en';
    const currentLang = language === 'en' ? 'en' : 'id';
    const prevDefault = intentTemplates[intent].defaultBody[otherLang];
    
    // Only update if the user hasn't modified the payload, or if it is completely empty
    if (!payload || payload === prevDefault) {
      setPayload(intentTemplates[intent].defaultBody[currentLang]);
    }
  }, [language]);

  const handleIntentChange = (newIntent: 'collab' | 'consult' | 'sponsor' | 'ping') => {
    const currentLang = language === 'en' ? 'en' : 'id';
    const prevDefault = intentTemplates[intent].defaultBody[currentLang];
    
    if (!payload || payload === prevDefault) {
      setPayload(intentTemplates[newIntent].defaultBody[currentLang]);
    }
    setIntent(newIntent);
  };

  const handleCopyEmail = () => {
    navigator.clipboard.writeText(personal.email);
    setCopiedEmail(true);
    setTimeout(() => setCopiedEmail(false), 2000);
  };

  // Calculate parameters for compose draft
  const currentSubject = intentTemplates[intent].subject[language === 'en' ? 'en' : 'id'];
  const fullSubject = senderName ? `${currentSubject} (From: ${senderName})` : currentSubject;
  const emailBody = `${payload}\n\n---\n[SYSTEM SENDER IDENT]: ${senderName || 'ANONYMOUS_COMMUNICATION'}\n[TRANSMISSION PORTAL]: PORTFOLIO_V2026`;
  const mailtoLink = `mailto:${personal.email}?subject=${encodeURIComponent(fullSubject)}&body=${encodeURIComponent(emailBody)}`;

  // Diagnostics evaluation (Friendly text)
  let statusText = '';
  let statusColor = '';
  let statusPulseClass = '';
  
  if (!senderName.trim() && !payload.trim()) {
    statusText = language === 'en' ? 'Awaiting message...' : 'Menunggu pesan...';
    statusColor = 'text-amber-500';
    statusPulseClass = 'bg-amber-500 animate-pulse';
  } else if (!senderName.trim()) {
    statusText = language === 'en' ? 'Ready to send (Anonymous)' : 'Siap kirim (Anonim)';
    statusColor = 'text-blue-500';
    statusPulseClass = 'bg-blue-500 animate-pulse';
  } else if (!payload.trim()) {
    statusText = language === 'en' ? 'Message is empty' : 'Pesan masih kosong';
    statusColor = 'text-brand-red';
    statusPulseClass = 'bg-brand-red animate-ping';
  } else {
    statusText = language === 'en' ? 'Ready to send!' : 'Siap kirim!';
    statusColor = 'text-emerald-500';
    statusPulseClass = 'bg-emerald-500 animate-pulse';
  }

  // Friendly Bilingual Labels
  const buildTitle = language === 'en' ? "LET'S BUILD SOMETHING AWESOME TOGETHER" : "MARI KITA BANGUN HAL LUAR BIASA BERSAMA";
  const buildDesc = language === 'en'
    ? "Feel free to reach out for startup collaborations, business inquiries, AI workflows, or just to say hello."
    : "Silakan hubungi saya untuk kolaborasi bisnis/startup, otomatisasi alur kerja AI, atau sekadar menyapa.";

  const nameLabel = language === 'en' ? 'NAME' : 'NAMA';
  const roleLabel = language === 'en' ? 'ROLE' : 'PERAN';
  const focusLabel = language === 'en' ? 'FOCUS' : 'FOKUS';
  const locationLabel = language === 'en' ? 'LOCATION' : 'LOKASI';
  const availabilityLabel = language === 'en' ? 'AVAILABILITY' : 'KETERSEDIAAN';

  const availabilityText = language === 'en' 
    ? "ACTIVE // OPEN FOR COLLABORATION" 
    : "AKTIF // TERBUKA UNTUK KERJASAMA";

  const modeDirectLabel = language === 'en' ? '[01] // QUICK CONNECT' : '[01] // HUBUNGI LANGSUNG';
  const modeComposeLabel = language === 'en' ? '[02] // SEND MESSAGE' : '[02] // KIRIM PESAN';

  const socialPorts = [
    {
      id: 'linkedin',
      name: 'LINKEDIN',
      handle: 'nugrahalabib',
      url: 'https://linkedin.com/in/nugrahalabib',
      icon: LinkedinIcon,
      color: 'hover:border-blue-500 hover:shadow-[0_0_12px_rgba(59,130,246,0.15)] hover:text-blue-600'
    },
    {
      id: 'tiktok',
      name: 'TIKTOK',
      handle: '@nugrahalabib',
      url: 'https://tiktok.com/@nugrahalabib',
      icon: TiktokIcon,
      color: 'hover:border-brand-red hover:shadow-[0_0_12px_rgba(229,57,53,0.15)] hover:text-brand-red'
    },
    {
      id: 'github',
      name: 'GITHUB',
      handle: 'nugrahalabib',
      url: 'https://github.com/nugrahalabib',
      icon: GithubIcon,
      color: 'hover:border-neutral-900 hover:shadow-[0_0_12px_rgba(5,5,5,0.08)] hover:text-neutral-900'
    },
    {
      id: 'instagram',
      name: 'INSTAGRAM',
      handle: '@nugrahalabib',
      url: 'https://instagram.com/nugrahalabib',
      icon: InstagramIcon,
      color: 'hover:border-pink-500 hover:shadow-[0_0_12px_rgba(236,72,153,0.15)] hover:text-pink-500'
    }
  ];

  return (
    <Section 
      id="contact" 
      number="06" 
      title={contactTitle} 
      subtitle={subtitle}
      className="!border-b-0 pb-20"
    >
      {/* Main layout container - Terminal Console Styling */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch border border-brand-border bg-brand-bg p-6 md:p-8 relative rounded-3xl shadow-sm">
        
        {/* LEFT COLUMN: Actions & Social Connection Ports */}
        <div className="lg:col-span-5 flex flex-col justify-between text-left border-b lg:border-b-0 lg:border-r border-brand-border/60 pb-8 lg:pb-0 lg:pr-8">
          <div>
            {/* Cyber Tab Console Modes */}
            <div className="flex border border-brand-border bg-brand-panel p-1 rounded-2xl mb-6">
              <button
                onClick={() => setActiveMode('direct')}
                className={`flex-1 font-mono text-[9px] font-black py-2 rounded-xl transition-all cursor-pointer ${
                  activeMode === 'direct'
                    ? 'bg-brand-black text-brand-bg shadow-sm'
                    : 'text-brand-text-secondary hover:text-brand-black'
                }`}
              >
                {modeDirectLabel}
              </button>
              <button
                onClick={() => {
                  setActiveMode('compose');
                  if (!payload) {
                    setPayload(intentTemplates[intent].defaultBody[language === 'en' ? 'en' : 'id']);
                  }
                }}
                className={`flex-1 font-mono text-[9px] font-black py-2 rounded-xl transition-all cursor-pointer ${
                  activeMode === 'compose'
                    ? 'bg-brand-black text-brand-bg shadow-sm'
                    : 'text-brand-text-secondary hover:text-brand-black'
                }`}
              >
                {modeComposeLabel}
              </button>
            </div>

            <span className="font-mono text-[9px] text-brand-red font-black tracking-widest uppercase block mb-1">
              {language === 'en' ? '// GET IN TOUCH' : '// HUBUNGI SAYA'}
            </span>
            <h3 className="text-2xl sm:text-3xl font-black uppercase tracking-tight text-brand-black mb-3">
              {buildTitle}
            </h3>
            <p className="text-xs text-brand-text-secondary leading-relaxed font-sans mb-6">
              {buildDesc}
            </p>

            <AnimatePresence mode="wait">
              {activeMode === 'direct' ? (
                <motion.div
                  key="direct-panel"
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0, y: -10 }}
                  transition={{ duration: 0.2 }}
                >
                  {/* Premium Interactive Mail Trigger Box */}
                  <div className="relative border border-brand-border bg-brand-panel p-4 rounded-2xl mb-8 flex items-center justify-between gap-4 font-mono">
                    <div className="flex items-center gap-3 min-w-0">
                      <div className="w-8 h-8 rounded-xl bg-brand-red/5 flex items-center justify-center border border-brand-red/20 text-brand-red">
                        <Mail size={16} />
                      </div>
                      <div className="min-w-0 flex flex-col">
                        <span className="text-[8px] text-brand-text-secondary tracking-wider font-bold">EMAIL ADDRESS</span>
                        <span className="text-xs font-black text-brand-black truncate select-all">{personal.email}</span>
                      </div>
                    </div>

                    {/* Action buttons */}
                    <div className="flex items-center gap-1.5 shrink-0">
                      {/* Copy Button */}
                      <button
                        onClick={handleCopyEmail}
                        className="w-8 h-8 border border-brand-border hover:border-brand-black bg-brand-bg rounded-xl flex items-center justify-center transition-colors cursor-pointer text-brand-black"
                        title={language === 'en' ? 'Copy Email' : 'Salin Email'}
                      >
                        {copiedEmail ? (
                          <Check size={14} className="text-emerald-500 stroke-[2.5]" />
                        ) : (
                          <Copy size={14} />
                        )}
                      </button>

                      {/* Send Button */}
                      <a
                        href={`mailto:${personal.email}`}
                        className="w-8 h-8 border border-brand-border hover:border-brand-black bg-brand-bg rounded-xl flex items-center justify-center transition-colors cursor-pointer text-brand-black"
                        title={language === 'en' ? 'Send Email' : 'Kirim Email'}
                      >
                        <ExternalLink size={14} />
                      </a>
                    </div>

                    {/* Temporarily Floating Tooltip Indicator */}
                    <AnimatePresence>
                      {copiedEmail && (
                        <motion.div
                          initial={{ opacity: 0, y: 10, scale: 0.95 }}
                          animate={{ opacity: 1, y: 0, scale: 1 }}
                          exit={{ opacity: 0, y: -10, scale: 0.95 }}
                          className="absolute -top-9 right-4 bg-brand-black text-brand-bg font-mono text-[9px] font-black tracking-widest px-2.5 py-1.5 rounded-lg shadow-md z-20 flex items-center gap-1"
                        >
                          <span>{language === 'en' ? 'COPIED!' : 'TERSALIN!'}</span>
                        </motion.div>
                      )}
                    </AnimatePresence>
                  </div>
                </motion.div>
              ) : (
                <motion.div
                  key="compose-panel"
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0, y: -10 }}
                  transition={{ duration: 0.2 }}
                  className="mb-8"
                >
                  {/* Cyber Intent Tabs */}
                  <div className="grid grid-cols-2 gap-2 mb-4">
                    {(Object.keys(intentTemplates) as Array<keyof typeof intentTemplates>).map((key) => (
                      <button
                        key={key}
                        type="button"
                        onClick={() => handleIntentChange(key)}
                        className={`font-mono text-[8px] font-black px-2.5 py-2.5 rounded-xl border text-center transition-all cursor-pointer truncate ${
                          intent === key
                            ? 'bg-brand-red/10 border-brand-red text-brand-red shadow-[0_0_8px_rgba(229,57,53,0.08)]'
                            : 'border-brand-border bg-brand-panel hover:border-brand-black text-brand-text-secondary hover:text-brand-black'
                        }`}
                      >
                        {intentTemplates[key].label[language === 'en' ? 'en' : 'id']}
                      </button>
                    ))}
                  </div>

                  {/* Name field */}
                  <div className="mb-4">
                    <label className="font-mono text-[8px] text-brand-text-secondary font-black block mb-1 uppercase">
                      {language === 'en' ? '// YOUR NAME' : '// NAMA ANDA'}
                    </label>
                    <input
                      type="text"
                      value={senderName}
                      onChange={(e) => setSenderName(e.target.value)}
                      placeholder={language === 'en' ? "Enter your name..." : "Masukkan nama Anda..."}
                      className="w-full bg-brand-panel border border-brand-border rounded-xl px-4 py-2.5 font-sans text-sm text-brand-black focus:outline-none focus:border-brand-black transition-colors"
                    />
                  </div>

                  {/* Body field */}
                  <div className="mb-4">
                    <label className="font-mono text-[8px] text-brand-text-secondary font-black block mb-1 uppercase">
                      {language === 'en' ? '// YOUR MESSAGE' : '// ISI PESAN'}
                    </label>
                    <textarea
                      rows={6}
                      value={payload}
                      onChange={(e) => setPayload(e.target.value)}
                      placeholder={language === 'en' ? "Write your message..." : "Tulis pesan Anda..."}
                      className="w-full bg-brand-panel border border-brand-border rounded-xl px-4 py-3 font-sans text-sm text-brand-black focus:outline-none focus:border-brand-black transition-colors resize-y min-h-[150px] leading-relaxed"
                    />
                  </div>

                  {/* Diagnostics status and sizes */}
                  <div className="grid grid-cols-2 gap-2 border border-brand-border bg-brand-panel/30 p-3 rounded-2xl font-mono text-[8px] mb-4">
                    <div className="flex flex-col text-left justify-center">
                      <span className="text-brand-text-secondary font-bold">STATUS</span>
                      <span className={`font-black flex items-center gap-1.5 mt-0.5 ${statusColor}`}>
                        <span className={`w-1.5 h-1.5 rounded-full ${statusPulseClass}`} />
                        {statusText}
                      </span>
                    </div>
                    <div className="flex flex-col text-right justify-center border-l border-brand-border/60 pl-3">
                      <span className="text-brand-text-secondary font-bold uppercase">
                        {language === 'en' ? 'MESSAGE_LENGTH' : 'PANJANG_PESAN'}
                      </span>
                      <span className="font-black text-brand-black mt-0.5">
                        {senderName.length + payload.length} {language === 'en' ? 'CHARS' : 'KARAKTER'}
                      </span>
                    </div>
                  </div>

                  {/* Actions */}
                  <div className="flex gap-2">
                    <a
                      href={mailtoLink}
                      className="flex-1 bg-brand-black text-brand-bg hover:bg-brand-red font-mono text-[10px] font-black py-3 rounded-xl transition-colors cursor-pointer flex items-center justify-center gap-2"
                    >
                      <span>{language === 'en' ? 'SEND EMAIL NOW ↗' : 'KIRIM EMAIL SEKARANG ↗'}</span>
                    </a>
                    
                    <button
                      onClick={() => {
                        navigator.clipboard.writeText(emailBody);
                        setCopiedPayload(true);
                        setTimeout(() => setCopiedPayload(false), 2000);
                      }}
                      className="w-12 border border-brand-border hover:border-brand-black bg-brand-bg rounded-xl flex items-center justify-center transition-colors cursor-pointer text-brand-black relative"
                      title={language === 'en' ? 'Copy Draft Payload' : 'Salin Draft Pesan'}
                    >
                      {copiedPayload ? (
                        <Check size={14} className="text-emerald-500 stroke-[2.5]" />
                      ) : (
                        <Copy size={14} />
                      )}
                      
                      {/* Copy Notification */}
                      <AnimatePresence>
                        {copiedPayload && (
                          <motion.div
                            initial={{ opacity: 0, y: 10, scale: 0.95 }}
                            animate={{ opacity: 1, y: 0, scale: 1 }}
                            exit={{ opacity: 0, y: -10, scale: 0.95 }}
                            className="absolute -top-9 right-0 bg-brand-black text-brand-bg font-mono text-[9px] font-black tracking-widest px-2.5 py-1.5 rounded-lg shadow-md z-20 flex items-center gap-1 shrink-0 whitespace-nowrap"
                          >
                            <span>{language === 'en' ? 'DRAFT COPIED!' : 'DRAFT TERSALIN!'}</span>
                          </motion.div>
                        )}
                      </AnimatePresence>
                    </button>
                  </div>
                </motion.div>
              )}
            </AnimatePresence>
          </div>

          {/* Social ports */}
          <div>
            <span className="font-mono text-[9px] text-brand-text-secondary font-black tracking-widest uppercase block mb-3">
              {language === 'en' ? '// SOCIAL MEDIA' : '// MEDIA SOSIAL'}
            </span>
            <div className="grid grid-cols-2 gap-3">
              {socialPorts.map((port) => {
                const Icon = port.icon;
                const isHovered = hoveredPort === port.id;
                return (
                  <a
                    key={port.id}
                    href={port.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    onMouseEnter={() => setHoveredPort(port.id)}
                    onMouseLeave={() => setHoveredPort(null)}
                    className={`flex items-center gap-3 border border-brand-border bg-brand-panel/30 p-3 rounded-2xl transition-all duration-300 font-mono ${port.color}`}
                  >
                    <Icon />
                    <div className="flex flex-col min-w-0 text-left">
                      <span className="text-[8px] text-brand-text-secondary tracking-widest font-black uppercase leading-none mb-0.5">{port.name}</span>
                      <span className="text-[9px] font-bold text-brand-black truncate">{port.handle}</span>
                    </div>
                    <SignalBars active={isHovered} />
                  </a>
                );
              })}
            </div>
          </div>
        </div>

        {/* CENTER COLUMN: Mascot Looping Video with Rotating Coordinate Rings */}
        <div className="lg:col-span-3 flex flex-col justify-center items-center select-none relative my-10 lg:my-0">
          <div className="relative w-64 h-64 flex items-center justify-center">
            
            {/* Spinning Holographic Rings - Complex SVG implementation */}
            <svg className="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 200 200">
              {/* Outer compass boundary */}
              <circle cx="100" cy="100" r="96" className="stroke-brand-border/40 fill-none" strokeWidth="1" strokeDasharray="3 5" />
              {/* Compass ticks boundary */}
              <circle cx="100" cy="100" r="89" className="stroke-brand-border/30 fill-none" strokeWidth="0.5" />
              
              {/* Inner spinning dashed ring 1 */}
              <motion.circle
                cx="100"
                cy="100"
                r="89"
                className="stroke-brand-red/30 fill-none"
                strokeWidth="1"
                strokeDasharray="20 40 10 30"
                animate={{ rotate: 360 }}
                transition={{ ease: "linear", duration: 15, repeat: Infinity }}
              />
              
              {/* Outer spinning dashed ring 2 */}
              <motion.circle
                cx="100"
                cy="100"
                r="83"
                className="stroke-brand-black/25 fill-none"
                strokeWidth="1.5"
                strokeDasharray="40 10 5 15"
                animate={{ rotate: -360 }}
                transition={{ ease: "linear", duration: 25, repeat: Infinity }}
              />
            </svg>
            
            {/* Hologram Compass ticks */}
            <div className="absolute inset-0 flex justify-between items-center pointer-events-none opacity-20">
              <div className="w-1.5 h-[1px] bg-brand-black" />
              <div className="w-1.5 h-[1px] bg-brand-black" />
            </div>
            <div className="absolute inset-0 flex flex-col justify-between items-center pointer-events-none opacity-20">
              <div className="h-1.5 w-[1px] bg-brand-black" />
              <div className="h-1.5 w-[1px] bg-brand-black" />
            </div>

            {/* Inner Video Container - Pure White Background & Scaled Mascot */}
            <div className="w-52 h-52 rounded-full overflow-hidden bg-white border border-brand-border/60 flex items-center justify-center relative z-10 shadow-sm">
              <video 
                src="/assets/vid-mascot-businessman.mp4" 
                autoPlay 
                loop 
                muted 
                playsInline
                className="w-full h-full object-contain mix-blend-multiply"
                style={{ transform: 'scale(1.7) translateY(12%)' }}
              />
            </div>
          </div>
          
          <div className="flex flex-col items-center mt-4 font-mono text-[8px] tracking-widest text-center">
            <span className="text-brand-red font-black animate-pulse uppercase">
              ▲ HOLOGRAM TRANSMITTING ▲
            </span>
            <span className="text-brand-text-secondary mt-1 select-all font-bold">
              LAT: -6.2088 // LNG: 106.8456
            </span>
          </div>
        </div>

        {/* RIGHT COLUMN: Database Dossier File */}
        <div className="lg:col-span-4 flex flex-col justify-between font-mono select-none text-xs border-t lg:border-t-0 lg:border-l border-brand-border/60 pt-8 lg:pt-0 lg:pl-8 text-left">
          
          {/* Header block of the credentials */}
          <div className="border border-brand-border bg-brand-panel p-4 rounded-2xl relative w-full mb-6">
            <TechCorner position="top-left" size={5} />
            <TechCorner position="bottom-right" size={5} />
            <span className="font-bold text-brand-black uppercase text-[10px] block mb-1">
              {language === 'en' ? '// PROFILE DETAILS' : '// DETAIL PROFIL'}
            </span>
            <div className="flex justify-between items-center text-[8px] text-brand-text-secondary tracking-widest leading-relaxed">
              <div>
                KEY: PORTFOLIO-2026-NUGI<br />
                STATUS: ONLINE
              </div>
              <div className="text-right flex flex-col items-end">
                <span>VERIFIED: YES</span>
                <span className="text-brand-red font-black">V.2026</span>
              </div>
            </div>
          </div>

          {/* Core key-value list */}
          <div className="space-y-4 flex-1 flex flex-col justify-center">
            
            {/* Operator Name */}
            <div className="grid grid-cols-12 gap-2 items-center">
              <div className="col-span-4 flex items-center gap-1.5 text-brand-text-secondary">
                <User size={13} className="text-brand-red" />
                <span>{nameLabel}</span>
              </div>
              <div className="col-span-8 font-black text-brand-black tracking-tight text-[11px] uppercase">
                {personal.name}
              </div>
            </div>

            {/* Designation */}
            <div className="grid grid-cols-12 gap-2 items-center border-t border-brand-border/40 pt-3">
              <div className="col-span-4 flex items-center gap-1.5 text-brand-text-secondary">
                <Briefcase size={13} className="text-brand-red" />
                <span>{roleLabel}</span>
              </div>
              <div className="col-span-8 font-bold text-brand-black tracking-tight leading-tight text-[11px] uppercase">
                {personal.role[language]}
              </div>
            </div>

            {/* Core Focus */}
            <div className="grid grid-cols-12 gap-2 items-start border-t border-brand-border/40 pt-3">
              <div className="col-span-4 flex items-center gap-1.5 text-brand-text-secondary mt-0.5">
                <Tag size={13} className="text-brand-red" />
                <span>{focusLabel}</span>
              </div>
              <div className="col-span-8 font-bold text-brand-black leading-snug text-[10px] uppercase">
                {personal.subTagline[language]}
              </div>
            </div>

            {/* Base Location */}
            <div className="grid grid-cols-12 gap-2 items-center border-t border-brand-border/40 pt-3">
              <div className="col-span-4 flex items-center gap-1.5 text-brand-text-secondary">
                <MapPin size={13} className="text-brand-red" />
                <span>{locationLabel}</span>
              </div>
              <div className="col-span-8 font-bold text-brand-black text-[11px] uppercase">
                {personal.location}
              </div>
            </div>

            {/* Availability */}
            <div className="grid grid-cols-12 gap-2 items-start border-t border-brand-border/40 pt-3">
              <div className="col-span-4 flex items-center gap-1.5 text-brand-text-secondary mt-0.5">
                <Calendar size={13} className="text-brand-red" />
                <span>{availabilityLabel}</span>
              </div>
              <div className="col-span-8 font-black text-brand-red leading-relaxed text-[9px] uppercase tracking-wide flex items-center gap-1.5">
                <span className="w-1.5 h-1.5 bg-brand-red rounded-full animate-ping" />
                {availabilityText}
              </div>
            </div>

          </div>

          {/* Bottom decorative barcode block */}
          <div className="mt-6 flex items-center justify-between border-t border-brand-border/40 pt-4 w-full">
            <span className="text-[8px] text-brand-text-secondary tracking-widest font-black uppercase">
              {language === 'en' ? '// CONTACT DECK' : '// DEK KONTAK'}
            </span>
            <Barcode value="COMM-SYSTEM" height={16} />
          </div>

        </div>

      </div>
    </Section>
  );
};
